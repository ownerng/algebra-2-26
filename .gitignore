# Entorno
.venv/
logs.txt*
__pycache__/
*.py[cod]
.pytest_cache/

# Datos pesados: se regeneran con  python -m src.setup
data/raw/
data/cache/

# El modelo entrenado SI se versiona (1.7 MB): es lo que permite que una copia
# recien clonada clasifique sin bajar el ~1 GB de datasets ni entrenar.
# results/scoal_model.pkl  <- versionado a proposito

# Via D: el checkpoint pesa 10-90 MB segun la arquitectura (fp16). Si lo quieres
# versionar usa Git LFS o quita esta linea; las metricas (json/csv) si se versionan.
results/fruit/*.pt

